# 이 파일을 .env 로 복사해서 실제 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# cp .env.example .env

# ── 기본 ─────────────────────────────
PORT=8080
# 127.0.0.1 = 이 서버 안에서만 접속 가능 (바깥 접속은 Caddy가 HTTPS로 받아서 넘겨줌)
HOST=127.0.0.1
# Caddy 뒤에서 실행하면 1 (로그인 잠금이 실제 접속 IP 기준으로 작동)
TRUST_PROXY=1
# 웹앱 접속 비밀번호: 12자 이상, 다른 곳에서 안 쓰는 것으로.
# 바꾸면 모든 기기가 로그아웃됩니다.
APP_PASSWORD=change-me
# 웹앱 주소. 실제 운영은 반드시 https:// (로그인 쿠키에 Secure가 붙음)
APP_URL=http://localhost:8080
# 1 이면 네이버 대신 가짜 주문으로 동작 (개발용)
MOCK=1
# 주문 확인 주기(초)
POLL_SECONDS=60

# ── 네이버 커머스API (커머스API센터에서 발급) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 알림 방식: console | alimtalk ──
NOTIFY=console

# ── 카카오 알림톡 (솔라피) ──
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오톡 채널 pfId, 승인된 템플릿 ID
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_ORDER=
SOLAPI_TEMPLATE_INQUIRY=
# 솔라피에 등록한 발신번호, 알림 받을 번호(쉼표로 여러 명)
SOLAPI_FROM=
NOTIFY_TO=

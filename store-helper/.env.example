# 이 파일을 .env 로 복사해서 실제 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# cp .env.example .env

# ── 기본 ─────────────────────────────
PORT=8080
# 웹앱 접속 비밀번호 (길고 추측하기 어렵게)
APP_PASSWORD=change-me
# 알림 메시지에 넣을 웹앱 주소 (예: https://내도메인)
APP_URL=http://localhost:8080
# 1 이면 네이버 대신 가짜 주문으로 동작 (개발용)
MOCK=1
# 주문 확인 주기(초)
POLL_SECONDS=60

# ── 네이버 커머스API (커머스API센터에서 발급) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 알림 방식: console | alimtalk ──
NOTIFY=console

# ── 카카오 알림톡 (솔라피) ──
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오톡 채널 pfId, 승인된 템플릿 ID
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_ORDER=
SOLAPI_TEMPLATE_INQUIRY=
# 솔라피에 등록한 발신번호, 알림 받을 번호(쉼표로 여러 명)
SOLAPI_FROM=
NOTIFY_TO=
